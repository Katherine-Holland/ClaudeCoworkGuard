{
  "productName": "CoworkGuard",
  "version": "1.1.0",
  "identifier": "com.coworkguard.menubar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "CoworkGuard",
        "width": 400,
        "height": 600,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https://tauri.localhost tauri://localhost; connect-src http://localhost:7070 http://127.0.0.1:7070; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://unpkg.com"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "\u00a9 2026 Katherine Weston",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "CoworkGuard monitors outbound requests to AI agent APIs and blocks sensitive data before it leaves your machine.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: Kathy Weston (R7Z3X3LDRF)",
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "../../requirements.txt": "requirements.txt",
      "../../scanner.py": "scanner.py",
      "../../skill_scanner.py": "skill_scanner.py",
      "../../proxy.py": "proxy.py",
      "../../server.py": "server.py",
      "../../dashboard.html": "dashboard.html",
      "../../domains.json": "domains.json",
      "../../clipboard_monitor.py": "clipboard_monitor.py",
      "../../file_write_monitor.py": "file_write_monitor.py",
      "../../mcp_trust/__init__.py": "mcp_trust/__init__.py",
      "../../mcp_trust/result.py": "mcp_trust/result.py",
      "../../mcp_trust/injection_scanner.py": "mcp_trust/injection_scanner.py",
      "../../mcp_trust/metadata_scanner.py": "mcp_trust/metadata_scanner.py",
      "../../mcp_trust/unicode_scanner.py": "mcp_trust/unicode_scanner.py",
      "../../mcp_trust/policy_engine.py": "mcp_trust/policy_engine.py",
      "../../actor_monitor/__init__.py": "actor_monitor/__init__.py",
      "../../actor_monitor/actors.json": "actor_monitor/actors.json",
      "../../actor_monitor/actor_registry.py": "actor_monitor/actor_registry.py",
      "../../actor_monitor/model_monitor.py": "actor_monitor/model_monitor.py",
      "../../actor_monitor/agent_guard.py": "actor_monitor/agent_guard.py",
      "../../actor_monitor/network_correlator.py": "actor_monitor/network_correlator.py",
      "../../core/__init__.py": "core/__init__.py",
      "../../core/identity/__init__.py": "core/identity/__init__.py",
      "../../core/identity/actor_stamper.py": "core/identity/actor_stamper.py",
      "../../core/identity/session_tracker.py": "core/identity/session_tracker.py",
      "../../pro/__init__.py": "pro/__init__.py",
      "../../pro/pro_startup.py": "pro/pro_startup.py",
      "../../pro/dev_env/__init__.py": "pro/dev_env/__init__.py",
      "../../pro/dev_env/path_classifier.py": "pro/dev_env/path_classifier.py",
      "../../pro/dev_env/process_scanner.py": "pro/dev_env/process_scanner.py",
      "../../pro/dev_env/file_watcher.py": "pro/dev_env/file_watcher.py",
      "../../pro/licence/__init__.py": "pro/licence/__init__.py",
      "../../pro/licence/checker.py": "pro/licence/checker.py"
    },
    "shortDescription": "Privacy protection for AI agents",
    "targets": "all"
  }
}