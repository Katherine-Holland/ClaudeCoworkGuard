{
  "manifest_version": 3,
  "name": "CoworkGuard",
  "version": "1.0.7",
  "description": "Local firewall for AI agents- monitors outbound API requests. Blocks sensitive data before it leaves your machine.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "webRequest",
    "notifications"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.mistral.ai/*",
    "https://api.cohere.com/*",
    "https://api.groq.com/*",
    "https://api.x.ai/*",
    "https://api.perplexity.ai/*",
    "https://api.cursor.sh/*",
    "https://copilot-proxy.githubusercontent.com/*",
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://poe.com/*",
    "https://mistral.ai/*",
    "https://groq.com/*",
    "https://copilot.microsoft.com/*",
    "https://character.ai/*",
    "https://coze.com/*",
    "https://huggingface.co/*",
    "https://you.com/*",
    "https://phind.com/*",
    "https://cursor.sh/*",
    "https://github.com/*"
  ],
  "homepage_url": "https://coworkguard.com",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://poe.com/*",
        "https://cursor.sh/*",
        "https://mistral.ai/*",
        "https://groq.com/*",
        "https://copilot.microsoft.com/*",
        "https://character.ai/*",
        "https://coze.com/*",
        "https://huggingface.co/chat*",
        "https://you.com/*",
        "https://phind.com/*",
        "https://github.com/copilot*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "window-ai-detector.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}