# CoworkGuard .gitignore

# Build artifacts
chrome-extension.zip
*.zip
*.tar.gz

# Rust build artifacts — large, auto-generated
menubar-app/src-tauri/target/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Test cache
.pytest_cache/

# Certificates — generated locally, never commit private keys
*.key
*.p12
coworkguard-ca-key.pem

# Local runtime files — generated at runtime, machine-specific
.coworkguard/
*.log

# CoworkGuard Pro licence — never commit a user's licence key
pro/licence.json

# Pro signing secret — never commit
pro/licence/.secret

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
.env.local
.venv/
venv/
